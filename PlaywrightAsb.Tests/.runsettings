<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <TestRunParameters>
        <Parameter name="SERVICEBUS_CONNECTION_STRING"
                   value="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;" />
        <Parameter name="SB_TOPIC" value="security-alerts" />
        <Parameter name="SB_QUEUE" value="incident-actions" />
    </TestRunParameters>

    <Playwright>
        <BrowserName>chromium</BrowserName>
        <ExpectTimeout>10000</ExpectTimeout>
        <LaunchOptions>
            <Headless>true</Headless>
        </LaunchOptions>
    </Playwright>
    <NUnit>
        <NumberOfTestWorkers>4</NumberOfTestWorkers>
    </NUnit>
</RunSettings>
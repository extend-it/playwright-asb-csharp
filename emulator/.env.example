# Copy to .env (git-ignored) and fill in.

# Y accepts the Azure Service Bus emulator and SQL Server licenses:
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
#   https://go.microsoft.com/fwlink/?linkid=857698
ACCEPT_EULA=N

# SA password for the emulator's SQL Edge container. Must meet SQL Server
# complexity rules: 8+ characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
